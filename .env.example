# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe (required for booking tools)
STRIPE_SECRET_KEY=sk_test_...

# OpenRouter (for AI features: NLP search, content generation, message drafting)
# Free tier available at https://openrouter.ai — no billing required
OPENROUTER_API_KEY=sk-or-v1-...

# Rate Limiting Tier: internal (100/min), beta (50/min), public (20/min)
MCP_RATE_LIMIT_TIER=public
