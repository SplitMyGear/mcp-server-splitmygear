# ── Auth ──────────────────────────────────────────────────────────────────────
# Operator key for the MCP endpoint (deny-by-default — required, or every request
# is refused). Callers present it as `x-api-key`, or send a user backend JWT as a
# Bearer token (issued by the backend's POST /api/v1/users/login).
MCP_API_KEY=your_operator_key

# Optional: the backend's JWT_SECRET. When set, the MCP verifies the HS256
# signature + expiry of forwarded user tokens locally (defense in depth — the
# backend re-validates every forwarded token regardless).
# MCP_BACKEND_JWT_SECRET=

# ── Backend REST API (the single source of truth for all data) ─────────────────
# All booking/messaging/experience/listing/pricing tools call the backend REST
# API forwarding the caller's JWT. Defaults to production if unset.
# BACKEND_API_URL=https://splitmygear-backend.vercel.app/api/v1

# ── Supabase ───────────────────────────────────────────────────────────────────
# Only used by the optional operator `api_keys` lookup (anon key). The MCP no
# longer holds a service-role client — SUPABASE_SERVICE_ROLE_KEY and
# STRIPE_SECRET_KEY are no longer used by any code (safe to remove + rotate).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── AI provider (message drafting + content tools) ─────────────────────────────
# One of these enables the AI tools (resolved live: OPENCODE → OPENROUTER → OPENAI).
# Free tier available at https://openrouter.ai — no billing required.
OPENROUTER_API_KEY=sk-or-v1-...

# Rate Limiting Tier: internal (100/min), beta (50/min), public (20/min)
MCP_RATE_LIMIT_TIER=public
