# ── Auth ──────────────────────────────────────────────────────────────────────
# Operator key for the MCP endpoint. Server-to-server callers present it as
# `x-api-key`; it unlocks the PUBLIC tools only (search, availability, quotes,
# pricing). Deny by default: a request with no valid credential is refused, and
# the server fails closed entirely when none of MCP_API_KEY,
# MCP_OAUTH_SIGNING_KEY and MCP_BACKEND_JWT_SECRET is configured.
MCP_API_KEY=your_operator_key

# ── OAuth sign-in for end users (renters + vendors) ────────────────────────────
# 32+ random bytes (e.g. `openssl rand -base64 48`). Seals every authorization
# code, access/refresh token, registered client id and in-flight sign-in
# request. Unset = OAuth endpoints are disabled (fail closed); rotating it
# signs every connected client out.
# MCP_OAUTH_SIGNING_KEY=

# Public origin of THIS server: the OAuth issuer and the protected resource
# origin. Must be stable in production. Falls back to Vercel's production URL
# (VERCEL_PROJECT_PRODUCTION_URL), then to the request origin (local dev only).
# MCP_PUBLIC_URL=https://mcp-server-splitmygear.vercel.app

# The backend's BFF_RELAY_KEY. When set, the hosted sign-in relays the END
# USER's IP to the backend login (x-smg-relay-key / x-smg-client-ip) so its
# per-IP brute-force throttle keys on the real caller, not on this server.
# MCP_BFF_RELAY_KEY=

# Optional allow-list of redirect hosts for OAuth client registration
# (comma-separated; a leading dot allows subdomains). Loopback is always
# allowed. Unset = any https host may register and the sign-in page labels the
# app "unverified".
# MCP_OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,.claude.com,cursor.com

# Trust x-real-ip / x-forwarded-for from a proxy YOU run in front of this
# server. Never needed on Vercel (its edge sets them); leave unset elsewhere
# unless a trusted proxy is in front, or clients could spoof their IP.
# MCP_TRUST_PROXY_HEADERS=1

# The backend's JWT_SECRET. Required to accept RAW backend JWT bearers
# (Authorization: Bearer <jwt>): they are signature-verified here, and an
# unverifiable JWT never authenticates. Also verifies the JWTs wrapped inside
# OAuth access tokens (defense in depth; the backend re-validates regardless).
# MCP_BACKEND_JWT_SECRET=

# ── Backend REST API (the single source of truth for all data) ─────────────────
# Every tool calls the backend REST API forwarding the user's own JWT.
# BACKEND_API_URL=https://splitmygear-backend.vercel.app/api/v1

# ── No database / payment credentials ─────────────────────────────────────────
# The MCP holds NO Supabase or Stripe client (ADR 0001). Payments happen on
# Stripe-hosted Checkout pages the backend creates.

# ── Rate limiting ───────────────────────────────────────────────────────────────
# Tier: internal (100/min), beta (50/min), public (20/min), default (10/min)
MCP_RATE_LIMIT_TIER=public

# Shared store for DISTRIBUTED rate limiting, the login throttle and the
# authorization-code replay cache (Upstash Redis REST; Vercel KV names also
# accepted: KV_REST_API_URL / KV_REST_API_TOKEN). Without it every limit is
# per serverless instance (best effort) and the backend's own throttles are
# the real control. Fails open to the in-memory limiter if the store is down.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Social sign-in on the hosted page ───────────────────────────────────────────
# "Continue with Google / Apple" appears when the backend reports the provider
# configured. The BACKEND must list this server's callback in its
# SOCIAL_AUTH_RETURN_ORIGINS so its OAuth callback may return here; pin the
# path, e.g. SOCIAL_AUTH_RETURN_ORIGINS=https://<this host>/oauth/social/callback
